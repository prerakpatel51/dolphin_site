DJANGO_SECRET_KEY=replace-with-a-64-character-random-secret
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

DATABASE_URL=postgres://dolphin:replace-with-a-strong-local-password@localhost:5432/dolphin

# Square (sandbox or production)
SQUARE_ENV=sandbox
SQUARE_ACCESS_TOKEN=
SQUARE_LOCATION_ID=
SQUARE_APP_ID=
# Set to 1 to bypass Square and mark bookings paid immediately (testing only)
FAKE_PAYMENTS=1

# Resend
RESEND_API_KEY=
EMAIL_FROM=Dolphin Island Tours <bookings@dolphinislandtours.com>
ADMIN_EMAIL=lewis@dolphinislandtours.com

# Frontend
FRONTEND_URL=http://localhost:5173

# Pricing
PRICE_PER_PERSON=60
MIN_PARTY=3
MAX_PARTY=6
